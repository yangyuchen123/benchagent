# Provider & credentials — copy to .env and fill in. Never commit .env!

# --- Provider selection (first match wins) ---
#   1. LLM_PROVIDER=openrouter|generic   (explicit)
#   2. LLM_API_KEY set                    -> generic (any OpenAI-compatible endpoint)
#   3. OPENROUTER_API_KEY set             -> openrouter
# LLM_PROVIDER=openrouter

# --- Option A: generic OpenAI-compatible endpoint (DeepSeek, vLLM, Ollama, ...) ---
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com/v1

# --- Option B: OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=                 # optional; defaults to https://openrouter.ai/api/v1

# --- Optional model overrides (priority: CLI --model > env > models.yaml) ---
# LLM_MODEL=stealth/ox-alpha          # global default for all agents
# LLM_MODEL_DESIGN=...                # per-role overrides
# LLM_MODEL_VERIFY=...

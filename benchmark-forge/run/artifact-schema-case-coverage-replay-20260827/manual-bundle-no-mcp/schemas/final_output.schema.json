{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConstraintTaskFinalOutput",
  "oneOf": [
    {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["case_id", "response"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "response": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["clarification"],
      "properties": {
        "clarification": {"type": "string", "minLength": 1},
        "safe_degradation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  ]
}
